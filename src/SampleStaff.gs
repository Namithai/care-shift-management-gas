/**
 * SampleStaff.gs
 * 動作確認用のサンプルスタッフ40人を staff シートに作り直す。
 * メニュー：シフト管理 ＞ 【確認用】サンプルスタッフ40人に作り直す
 */

/** staff シートの2行目以降を消して、サンプル40人を書き込む */
function setupSampleStaff() {
  var ui = SpreadsheetApp.getUi();
  var res = ui.alert(
    'サンプルスタッフの作り直し',
    'staff シートの2行目以降をすべて消して、\n' +
    'サンプルのスタッフ40人を作り直します。\n\n' +
    '※本番のスタッフが入っているときは実行しないでください。\n\n' +
    'よろしいですか？',
    ui.ButtonSet.OK_CANCEL);
  if (res !== ui.Button.OK) return;

  var sh = SpreadsheetApp.getActive().getSheetByName('staff');
  if (!sh) { ui.alert('staff シートが見つかりません。'); return; }

  sh.getRange(1, 2).setValue('氏名');

  var rows = sampleStaffRows_();

  var last = sh.getLastRow();
  if (last >= 2) sh.getRange(2, 1, last - 1, 26).clearContent();
  sh.getRange(2, 1, rows.length, 26).setValues(rows);

  ui.alert('サンプルスタッフ ' + rows.length + '人を作りました。');
}

